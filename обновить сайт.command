#!/bin/bash
# ============================================================
#  ХлебМясо — обновление сайта
#  Двойной клик по этому файлу отправляет все изменения
#  из папки на GitHub. Через 1–2 минуты они появятся на сайте.
# ============================================================

cd "$(dirname "$0")" || exit 1

SITE="https://derbent-developer.github.io/xleb-myaso/"

# чтобы окно не закрылось молча и было видно, что произошло
finish () {
  echo
  echo "------------------------------------------------------------"
  echo "$1"
  echo
  read -n 1 -s -r -p "Нажмите любую клавишу, чтобы закрыть окно..."
  echo
  exit "$2"
}

echo "============================================================"
echo "  Обновление сайта ХлебМясо"
echo "============================================================"
echo

if [ ! -d .git ]; then
  finish "❌ Это не та папка: здесь нет репозитория git.
   Файл «обновить сайт.command» должен лежать рядом с index.html." 1
fi

if [ ! -f index.html ]; then
  finish "❌ Не вижу index.html — похоже, файл переименовали или удалили." 1
fi

# --- что изменилось ---
CHANGES=$(git status --porcelain)

if [ -z "$CHANGES" ]; then
  finish "✅ Изменений нет — сайт и так актуален.
   Адрес сайта: $SITE" 0
fi

echo "Изменения, которые уедут на сайт:"
echo
git -c core.quotepath=false status --short
echo

# --- сохраняем ---
git add -A || finish "❌ Не удалось подготовить файлы (git add)." 1

if ! git commit -q -m "Обновление сайта — $(date '+%d.%m.%Y %H:%M')"; then
  finish "❌ Не удалось сохранить изменения (git commit)." 1
fi

echo "Сохранено. Отправляю на GitHub..."
echo

# --- отправляем ---
if git push -q origin main 2>/dev/null; then
  finish "✅ Готово! Изменения отправлены.

   Сайт обновится через 1–2 минуты — GitHub пересобирает страницу.
   Адрес: $SITE

   Если открыли сайт и видите старую версию — обновите страницу
   с очисткой кэша: Cmd + Shift + R." 0
fi

# push не прошёл — возможно, на GitHub есть более свежие правки
echo "С первого раза не отправилось. Пробую забрать свежую версию с GitHub..."
echo

if git pull --rebase --autostash -q origin main 2>/dev/null && git push -q origin main 2>/dev/null; then
  finish "✅ Готово! Изменения отправлены (пришлось сначала подтянуть правки с GitHub).

   Сайт обновится через 1–2 минуты.
   Адрес: $SITE" 0
fi

finish "❌ Отправить не получилось.

   Частые причины:
   • нет интернета;
   • правки делали и здесь, и прямо на сайте GitHub — они конфликтуют.

   Изменения при этом СОХРАНЕНЫ на компьютере, ничего не потеряно.
   Покажите это окно разработчику — разберёмся." 1
